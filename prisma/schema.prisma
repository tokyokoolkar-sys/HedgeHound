generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaperTicket {
  id          String   @id @default(cuid())
  symbol      String
  side        String
  notionalUsd Float
  leverage    Float
  holdHours   Int
  note        String?
  createdAt   DateTime @default(now())
}